# Google Cloud Console에서 만든 YouTube Data API v3 키
google_cloud_api_key=본인이_발급받은_키

# Supabase > Connect > Session pooler에서 복사한 PostgreSQL URI
# 실제 비밀번호가 들어가므로 GitHub에 올리지 않는다.
SUPABASE_CONNECTION_STRING=postgresql://postgres.프로젝트참조값:비밀번호@호스트:5432/postgres

# 보고서 각주에 쓸 공개 프로젝트 URL이 필요하면 별도로 기록할 수 있다.
SUPABASE_PROJECT_URL=https://프로젝트참조값.supabase.co
